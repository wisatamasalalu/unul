datang
untuk array.dinamis

takdir.soft kosmetik = muat_snul("gaya.snul")
takdir.soft game_hidup = 1
takdir.soft detak_waktu = 0

takdir.soft cek_file = cari("monster.imah")
takdir.soft monster = { "nama": "UNULZILLA", "lapar": 10, "bahagia": 10, "umur": 0 }
jika panjang(cek_file) > 0 maka
    coba maka monster = impor("monster.imah") tabu melanggar e maka pasrah
putus

^^ 🟢 1. MUAT OTIM SATU KALI SAJA! (Pohon DOM Global)
takdir.soft otim_str = '#!datang\n<wadah id="utama">\n'
otim_str = otim_str + '    <judul> "--- ' + monster.nama + ' ---" </judul>\n'
otim_str = otim_str + '    <areanulis id="layar_monster"> "MEMUAT..." </areanulis>\n'
otim_str = otim_str + '    <tombol id="btn_makan"> "[PANAH KIRI] BERI MAKAN" </tombol>\n'
otim_str = otim_str + '    <tombol id="btn_main"> "[PANAH KANAN] AJAK MAIN" </tombol>\n'
otim_str = otim_str + '    <tombol id="btn_keluar"> "[ESC] KELUAR & SIMPAN" </tombol>\n'
otim_str = otim_str + '</wadah>\npergi!#'

tulis("ui_awal.otim", otim_str)
takdir.soft ui_game = muat_otim("ui_awal.otim")

^^ 🟢 2. FUNGSI HANYA MERAKIT TEKS (BUKAN MERETAS DOM)
ciptakan fungsi rakit_teks_layar(m) maka
    takdir.soft wajah = "( O _ O )"
    jika m.lapar > 20 maka wajah = "( T _ T )" putus
    jika m.bahagia > 20 maka wajah = "( ^ _ ^ )" putus
    jika m.lapar > 30 maka wajah = "( x _ x )" putus

    takdir.soft layar = "\n\n/\\_/\\\n  " + wajah + "\n  = ^ =\n\n"
    layar = layar + "Lapar: " + m.lapar + " | Bahagia: " + m.bahagia + " | Umur: " + m.umur + "\n"
    jika m.lapar > 30 maka layar = layar + "\nMONSTER ANDA MATI KELAPARAN!\n" putus
    
    pulang layar
putus

^^ 🔥 RETAS DOM DI GLOBAL! (Langsung kena jantungnya)
takdir.soft teks_awal = rakit_teks_layar(monster)
retas_memori_dom(ui_game, "layar_monster", teks_awal)

^^ 3. SIKLUS GAME ENGINE (100ms per loop)
siklus selama game_hidup == 1 maka
    takdir.soft aksi = tampilkan_tui(ui_game, kosmetik, 100)  
    takdir.soft perlu_render = 0

    ^^ 🟢 LOGIKA DATAR MUTLAK DENGAN ASSIGNMENT BERSARANG
    jika aksi == "btn_makan" maka
        monster.lapar = monster.lapar - 2
        perlu_render = 1
    putus

    jika aksi == "PANAH_KIRI" maka
        monster.lapar = monster.lapar - 2
        perlu_render = 1
    putus

    jika aksi == "btn_main" maka
        monster.bahagia = monster.bahagia + 3
        monster.lapar = monster.lapar + 1
        perlu_render = 1
    putus

    jika aksi == "PANAH_KANAN" maka
        monster.bahagia = monster.bahagia + 3
        monster.lapar = monster.lapar + 1
        perlu_render = 1
    putus

    jika aksi == "btn_keluar" maka
        game_hidup = 0
    putus

    jika aksi == "TUTUP_PAKSA" maka
        game_hidup = 0
    putus

    jika aksi == "DETAK" maka
        detak_waktu = detak_waktu + 1
        jika detak_waktu > 20 maka
            monster.lapar = monster.lapar + 1
            monster.bahagia = monster.bahagia - 1
            monster.umur = monster.umur + 1
            detak_waktu = 0
            perlu_render = 1
        putus
    putus

    jika perlu_render == 1 maka
        ekspor(monster, "monster.imah")
        
        ^^ 🔥 RETAS DOM DI GLOBAL KEMBALI AGAR LAYAR BERUBAH!
        takdir.soft teks_baru = rakit_teks_layar(monster)
        retas_memori_dom(ui_game, "layar_monster", teks_baru)
    putus
putus

pasrah(ui_game)
pasrah(kosmetik)
ketik("Game Disimpan. Sampai jumpa!")
pergi
datang
untuk array.dinamis

takdir.soft kosmetik = muat_snul("gaya.snul")
takdir.soft game_hidup = 1
takdir.soft detak_waktu = 0

^^ ==========================================
^^ 1. INISIALISASI DATABASE & STATE DATAR
^^ ==========================================
takdir.soft cek_file = cari("monster.imah")
takdir.soft stat_lapar = 10
takdir.soft stat_bahagia = 10
takdir.soft stat_umur = 0

jika panjang(cek_file) > 0 maka
    coba maka 
        takdir.soft db = impor("monster.imah")
        stat_lapar = db.lapar
        stat_bahagia = db.bahagia
        stat_umur = db.umur
    tabu melanggar e maka 
        pasrah
putus

^^ ==========================================
^^ 2. FUNGSI SAKTI: GENERATOR UI (State-Driven)
^^ Menggantikan retas_memori_dom dengan Virtual DOM!
^^ ==========================================
ciptakan fungsi render_ui(v_lapar, v_bahagia, v_umur) maka
    takdir.soft wajah = "( O _ O )"
    jika v_lapar > 20 maka wajah = "( T _ T )" putus
    jika v_bahagia > 20 maka wajah = "( ^ _ ^ )" putus
    jika v_lapar > 30 maka wajah = "( x _ x )" putus

    takdir.soft layar = "\n\n/\\_/\\\n  " + wajah + "\n  = ^ =\n\n"
    layar = layar + "Lapar: " + v_lapar + " | Bahagia: " + v_bahagia + " | Umur: " + v_umur + "\n"
    jika v_lapar > 30 maka layar = layar + "\nMONSTER ANDA MATI KELAPARAN!\n" putus

    takdir.soft otim_str = '#!datang\n<wadah id="utama">\n'
    otim_str = otim_str + '    <judul> "--- UNULZILLA ---" </judul>\n'
    otim_str = otim_str + '    <areanulis id="layar_monster"> "' + layar + '" </areanulis>\n'
    otim_str = otim_str + '    <tombol id="btn_makan"> "[PANAH KIRI] BERI MAKAN" </tombol>\n'
    otim_str = otim_str + '    <tombol id="btn_main"> "[PANAH KANAN] AJAK MAIN" </tombol>\n'
    otim_str = otim_str + '    <tombol id="btn_keluar"> "[ESC] KELUAR & SIMPAN" </tombol>\n'
    otim_str = otim_str + '</wadah>\npergi!#'

    tulis("sementara.otim", otim_str)
    takdir.soft ui_baru = muat_otim("sementara.otim")
    pulang ui_baru
putus

^^ Bangkitkan UI pertama kali berdasarkan State
takdir.soft ui_game = render_ui(stat_lapar, stat_bahagia, stat_umur)

^^ ==========================================
^^ 3. SIKLUS GAME ENGINE (100ms per loop)
^^ ==========================================
siklus selama game_hidup == 1 maka
    takdir.soft aksi = tampilkan_tui(ui_game, kosmetik, 100)  
    takdir.soft perlu_render = 0

    jika aksi == "btn_makan" atau aksi == "PANAH_KIRI" maka
        jika stat_lapar > 0 maka stat_lapar = stat_lapar - 2 putus
        perlu_render = 1
    lain jika aksi == "btn_main" atau aksi == "PANAH_KANAN" maka
        stat_bahagia = stat_bahagia + 3
        stat_lapar = stat_lapar + 1
        perlu_render = 1
    lain jika aksi == "btn_keluar" atau aksi == "TUTUP_PAKSA" maka
        game_hidup = 0
    lain jika aksi == "DETAK" maka
        jika stat_lapar <= 30 maka
            detak_waktu = detak_waktu + 1
            jika detak_waktu > 20 maka
                stat_lapar = stat_lapar + 1
                stat_bahagia = stat_bahagia - 1
                stat_umur = stat_umur + 1
                detak_waktu = 0
                perlu_render = 1
            putus
        putus
    putus

    ^^ 🟢 RENDER ULANG HANYA JIKA ADA PERUBAHAN STATE!
    jika perlu_render == 1 maka
        ^^ 1. SEMAYAMKAN KE DATABASE DENGAN VARIABEL BARU (Anti Bug Objek)
        takdir.soft simpan_db = { "nama": "UNULZILLA", "lapar": stat_lapar, "bahagia": stat_bahagia, "umur": stat_umur }
        ekspor(simpan_db, "monster.imah")
        
        ^^ 2. RE-RENDER UI SEPERTI REACT!
        ui_game = render_ui(stat_lapar, stat_bahagia, stat_umur)
    putus
putus

pasrah(ui_game)
pasrah(kosmetik)
ketik("Game Disimpan. Sampai jumpa!")
pergi
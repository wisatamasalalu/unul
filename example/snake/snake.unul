^^ PROTO-ENGINE: GAME KANVAS MURNI
datang

layar_alternatif_buka()

takdir.soft game_hidup = 1
takdir.soft player_x = 25
takdir.soft player_y = 10

siklus selama game_hidup == 1 maka
    ^^ 1. Bersihkan frame sebelumnya
    layar_bersih()
    
    ^^ 2. Gambar Batas Dunia
    takdir.soft i = 1
    siklus selama i < 50 maka
        layar_piksel(i, 1, "garis_h", "cyan")
        layar_piksel(i, 20, "garis_h", "cyan")
        i = i + 1
    putus
    
    ^^ 3. Gambar Pemain
    layar_piksel(player_x, player_y, "penuh", "merah")
    layar_cetak(2, 2, "Gunakan W/A/S/D atau Panah. ESC untuk keluar.", "kuning")
    
    ^^ 4. Dengarkan Alam Semesta (Tangkap Tombol Instan)
    takdir.soft tombol = layar_baca_tombol()
    
    jika tombol == "w" atau tombol == "PANAH_ATAS" maka
        player_y = player_y - 1
    lain jika tombol == "s" atau tombol == "PANAH_BAWAH" maka
        player_y = player_y + 1
    lain jika tombol == "a" atau tombol == "PANAH_KIRI" maka
        player_x = player_x - 1
    lain jika tombol == "d" atau tombol == "PANAH_KANAN" maka
        player_x = player_x + 1
    lain jika tombol == "ESC" maka
        game_hidup = 0
    putus
    
    ^^ 5. Tahan waktu agar game berjalan 10 Frame per Detik (100ms)
    jeda(100)
putus

layar_alternatif_tutup()
ketik("Game Over! Terima kasih telah bermain.")
pergi
#!datang
<wadah id="layar_register" @layar.utama>
    <judul id="t1"> === PENDAFTARAN URANTIA === </judul>
    <masukan id="id_nama"> Nama Baru : </masukan>
    <masukan_sandi id="id_sandi"> Sandi Baru : </masukan_sandi>
    <masukan_sandi id="id_sandi_konfirm"> Ulangi Sandi : </masukan_sandi>
    <teks id="id_notif" @teks.peringatan> </teks>
    <tombol id="btn_daftar" @tombol> Daftarkan Saya! </tombol>
    <tombol id="pindah_login" @tombol> Kembali ke Login </tombol>
</wadah>
pergi!#
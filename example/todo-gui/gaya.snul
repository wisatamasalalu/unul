@layar.utama {
    warna_latar: #1E1E1EFF; ^^ Mode Gelap Modern
    warna_teks: #00FF00FF;  ^^ Hijau Hacker
    susunan: kolom;
    lebar: penuh;
}

@tombol {
    warna_latar: #2C3E50FF; 
    warna_teks: #FFFFFFFF;
    lebar: 300;             ^^ Buat tombol lebih lebar agar mudah diklik!
    tinggi: 40;
}

@tombol:hover {
    warna_latar: #E74C3CFF; ^^ Merah saat di-hover
    warna_teks: #FFFFFFFF;
}

@masukan {
    warna_latar: #ECF0F1FF;
    warna_teks: #2C3E50FF;
    lebar: 300;             ^^ Samakan lebarnya dengan tombol
}

@masukan_sandi {
    warna_latar: #ECF0F1FF;
    warna_teks: #2C3E50FF;
    lebar: 300;
}

@teks.peringatan {
    warna_teks: #E74C3CFF; ^^ Merah untuk Error
}
#!datang
<wadah_dinamis id="layar_dashboard" @layar.utama>
    <judul id="t2"> === CATATAN RAHASIA === </judul>
    <teks id="id_nama_user"> Pengguna Aktif: </teks>
    
    <teks id="label_tugas"> Tulis Tugas Panjang Di Sini: </teks>
    <areanulis id="id_todo" atribut="lebar: 400; tinggi: 150;"> </areanulis>
    
    <tombol id="btn_tambah" @tombol> Tambah Tugas </tombol>
    
    <teks id="t3"> Daftar Tugas Anda: </teks>
    
    ^^ Di sinilah daftar tugas akan dimuntahkan
    <teks id="id_daftar_todo"> - Belum ada tugas - </teks>
    
    <tombol id="btn_keluar" @tombol> Keluar Akun </tombol>
</wadah_dinamis>
pergi!#